# ==============================================================================
# standard-api - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Security & Authentication
# Se preenchido, todas as rotas da API exigem o header `apikey` ou `x-api-key`
GLOBAL_API_KEY=standard_secret_key_123456

# Storage Configuration
SESSIONS_DIR=./sessions

# PostgreSQL Database Configuration
DATABASE_ENABLED=true
DATABASE_URL=postgresql://standard:standard_password@postgres:5432/standard_api?sslmode=disable
POSTGRES_USER=standard
POSTGRES_PASSWORD=standard_password
POSTGRES_DB=standard_api
POSTGRES_PORT=5432

# Redis Configuration (Queue, Rate Limiting & Cache)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Global Webhook Defaults (Optional)
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_EVENTS=messages.upsert,connection.update,receipts.update,presence.update
